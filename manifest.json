{
    "manifest_version": 2,
    "name": "Group Ur Tabs",
    "version": "0.1.0",

    "author": "Shrekich",
    "description": "Better groups control.",
    
    "browser_action": {
        "default_title": "Group Ur Tabs"
    },
    "background": {
        "scripts": [
            "scripts/grouper.js"
        ],
        "persistent": false
    },

    "browser_specific_settings": {
        "gecko": {
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },

    "permissions": [
        "activeTab",
        "tabs",
        "tabGroups",
        "storage",
        "sessions"
    ]
}